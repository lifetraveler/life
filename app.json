{
  "expo": {
    "name": "life",
    "slug": "life",
    "version": "0.1.0",
    "scheme": "life",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.vibecoding.life",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vibecoding.life",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "允许 $(PRODUCT_NAME) 读取你的日历以单向导入系统日历事件"
        }
      ],
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "label": "今日待办",
              "description": "在桌面查看今日过期与已安排的待办，可快速记录",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/TodayWidget.png",
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      "expo-localization"
    ]
  }
}
