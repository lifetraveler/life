<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
  <!-- 切片 9：expo-calendar config plugin 在 bare 工程下的等价注入（plugin 只在 prebuild 时写 manifest，
       本工程 android/ 已 checked in，故手工同步）。读取经 expo-calendar requestCalendarPermissionsAsync，
       其实现以单一系统弹窗同时请求两权限并要求均授予（AGENTS.md §7.15 方案 A 如实记录）；
       本应用无任何系统日历写回调用路径。 -->
  <uses-permission android:name="android.permission.READ_CALENDAR"/>
  <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
  <!-- 切片 20：电池优化白名单（变更 A）所需的 normal 级运行权限——唤起系统授权弹窗
       ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 的 manifest 前提（提案
       docs/proposals/slice-20-network-channel-reliability.md）。本工程 android/ 已 checked in，
       plugin 只在 prebuild 时写 manifest，故手工同步（与切片 9 惯例一致）。
       提案原写 app.json android.permissions 声明，经复核改为仅此处声明：app.json 一旦声明
       permissions 列表，未来 prebuild 会整体替换默认权限集，有丢失现有权限的风险（§5）。 -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="life"/>
        <data android:scheme="exp+life"/>
      </intent-filter>
    </activity>
    <!-- 切片 10：react-native-android-widget config plugin 在 bare 工程下的等价注入
         （plugin 只在 prebuild 时写 manifest，本工程 android/ 已 checked in，故手工同步；
         与 plugin 输出逐字段一致，勿改 name/action，改动须同步 app.json 的 plugin 配置）。
         service：ListWidget 集合视图服务（本切片未用 ListWidget，plugin 无条件注入，保持一致）；
         receiver：TodayWidget AppWidgetProvider，类在
         android/app/src/main/java/com/vibecoding/life/widget/TodayWidget.java，
         provider 配置在 res/xml/widgetprovider_todaywidget.xml；
         com.vibecoding.life.WIDGET_CLICK 由库原生侧发出，经 headless 任务转发 JS（taskHandler 展开 deep link）。 -->
    <service android:name="com.reactnativeandroidwidget.RNWidgetCollectionService" android:permission="android.permission.BIND_REMOTEVIEWS"/>
    <receiver android:name=".widget.TodayWidget" android:exported="false" android:label="今日待办">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
        <action android:name="com.vibecoding.life.WIDGET_CLICK"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/widgetprovider_todaywidget"/>
    </receiver>
  </application>
</manifest>